---
layout: layouts/base.njk
title: "Blog & Updates"
---
{% block head %}
<style>
  .page-hero{ padding: 80px 0 50px; }
  .page-hero h1{ font-size: clamp(32px, 4vw, 46px); font-weight: 700; }
  .page-hero p{ margin-top: 12px; font-size: 17px; color: var(--ink-soft); max-width: 500px; }

  .blog-grid{
    display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 24px;
    padding-bottom: 100px;
  }
  .blog-card{
    background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-lg);
    padding: 30px; transition: transform .35s var(--ease), box-shadow .35s var(--ease), border-color .35s var(--ease);
  }
  .blog-card:hover{ transform: translateY(-6px); box-shadow: var(--shadow-md); border-color: transparent; }
  .blog-card .meta{ font-size: 13px; color: var(--ink-faint); font-weight:500; margin-bottom: 14px; }
  .blog-card h2{ font-size: 19px; font-weight:700; margin-bottom: 10px; }
  .blog-card p{ font-size: 14.5px; color: var(--ink-soft); line-height: 1.6; margin-bottom: 18px; }
  .blog-card .read-more{ font-size: 14px; font-weight:600; color: var(--purple); display:inline-flex; align-items:center; gap:4px; }
  .blog-card .read-more:hover{ gap:8px; }

  @media (max-width: 920px){
    .blog-grid{ grid-template-columns:1fr; }
  }
</style>
{% endblock %}

<section class="page-hero">
  <div class="wrap">
    <h1>Blog &amp; Updates</h1>
    <p>Tips, behind-the-scenes, and what's coming next for EmojiAI.</p>
  </div>
</section>

<section>
  <div class="wrap blog-grid">
{%- for post in collections.post | reverse %}
    <article class="blog-card reveal">
      <div class="meta">{{ post.date | dateDisplay }} · {{ post.data.readTime }} read</div>
      <h2>{{ post.data.title }}</h2>
      <p>{{ post.data.excerpt }}</p>
      <a href="{{ post.url }}" class="read-more">Read more →</a>
    </article>
{%- endfor %}
  </div>
</section>
